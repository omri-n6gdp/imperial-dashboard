#!/bin/bash
# Imperial Dashboard: starts the dashboard server (v2, http://127.0.0.1:8766) in the background if it isn't
# already running, then opens the dashboard in Safari. The server keeps running after you close Safari,
# so it opens instantly next time (it stops when you restart the Mac).
# Server output: ~/Library/Logs/Imperial Dashboard.log

PORT=8766
URL="http://127.0.0.1:$PORT/"
LOG="$HOME/Library/Logs/Imperial Dashboard.log"
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
mkdir -p "$(dirname "$LOG")"

alert() { osascript -e "display alert \"Imperial Dashboard\" message \"$1\"" >/dev/null 2>&1; }
# Is a dashboard server answering? Its version address replies instantly. Servers from before 9 Nov don't have it,
# so fall back to the full data address, which reads every file and can take a few seconds on a busy Mac.
# (A one-second limit on that address could miss a slow reply and start a second server on the next port.)
running() { curl -s -o /dev/null -f -m 2 "${URL}api/server-version" || curl -s -o /dev/null -f -m 4 "${URL}api/overview"; }

# The dashboard folder: the one this app sits in, or ~/Imperial Dashboard if the app has been moved.
APP="$(cd "$(dirname "$0")/../.." && pwd)"
ROOT="$(dirname "$APP")"
[ -f "$ROOT/_meta/app-v2/server.py" ] || ROOT="$HOME/Imperial Dashboard"

# Restart a server left running from an older version of the dashboard (it reports its version).
WANT="$(sed -n "s/^SERVER_VERSION = '\([^']*\)'.*/\1/p" "$ROOT/_meta/app-v2/server.py" 2>/dev/null)"
if running && [ -n "$WANT" ]; then
  HAVE="$(curl -s -m 1 "${URL}api/server-version" | sed -n 's/.*"version": *"\([^"]*\)".*/\1/p')"
  if [ "$HAVE" != "$WANT" ]; then
    echo "--- $(date '+%Y-%m-%d %H:%M:%S') restarting the server (${HAVE:-old} -> $WANT)" >>"$LOG"
    PIDS="$(lsof -ti tcp:$PORT -sTCP:LISTEN 2>/dev/null)"
    [ -n "$PIDS" ] && kill $PIDS 2>/dev/null
    for _ in $(seq 1 40); do running || break; sleep 0.25; done
  fi
fi

if ! running; then
  if [ ! -f "$ROOT/_meta/app-v2/server.py" ]; then
    alert "Can't find the Imperial Dashboard folder. Keep this app inside it (or keep the folder at ~/Imperial Dashboard)."
    exit 1
  fi
  PY="$(command -v python3)"
  if [ -z "$PY" ]; then
    alert "Python 3 isn't installed. Double-click 'Imperial Dashboard v2.command' in the dashboard folder once to set it up."
    exit 1
  fi
  cd "$ROOT" || exit 1
  echo "--- $(date '+%Y-%m-%d %H:%M:%S') starting the server" >>"$LOG"
  nohup "$PY" "_meta/app-v2/server.py" --port "$PORT" --no-browser >>"$LOG" 2>&1 </dev/null &
  disown
  for _ in $(seq 1 60); do running && break; sleep 0.25; done
  if ! running; then
    alert "The dashboard server didn't start. The details are in ~/Library/Logs/Imperial Dashboard.log"
    exit 1
  fi
fi

open -a Safari "$URL"
